# Bonanza CRM — environment configuration
#
# Copy to `.env` and fill in. NEVER commit the filled-in file, and never paste
# these values into a chat, ticket or email — set them on the server directly.
#
# Every integration is simulated while its credentials are blank, so the system
# runs end to end with none of this set. Fill in a section to make that one live.

# ---------------------------------------------------------------- core ----

PORT=4100

# 64 hex characters. Generate with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Encrypts PAN, partner bank details and KYC form payloads at rest.
# The server refuses to start in production without it.
CRM_MASTER_KEY=

# ------------------------------------------------------------------ AI ----

# Leave blank to use the built-in offline provider (no external calls at all).
ANTHROPIC_API_KEY=

# hybrid | deidentify_only | in_india_only | offline
#   hybrid         call transcripts and KYC coaching stay in India; everything
#                  else is de-identified before it leaves. (recommended)
#   in_india_only  nothing leaves the country under any condition.
CRM_AI_RESIDENCY=hybrid

# In-country inference endpoint, for the capabilities that may not leave India.
CRM_AI_INDIA_URL=

# Which environment this is, for configuration promotion (P2-03) and for the
# audit record it writes. Free text: development, uat, production.
#
# Deliberately separate from NODE_ENV. A UAT box and a Production box both run
# NODE_ENV=production, and telling those two apart is the whole point of this
# label -- a promotion row saying "applied in production" has to mean it.
CRM_ENVIRONMENT=

# ------------------------------------------- Cube QuickCall (dialler/CTI) --

# REST base for the QuickCall API. This is NOT the agent-popup URL
# (cubehosted.net/cube/), which is a different service entirely.
#
#   Production  https://raphsody.in          (dials real numbers)
#   UAT         https://uat-raphsody.in      (no DNS record as of 3 Sep 2026)
#
# Every secure endpoint lives under the prefix /QuickCall61AuthToken/ — the
# adapter adds that itself, so set only the scheme and host here.
#
# Leave BLANK unless this deployment is meant to place live calls. Blank keeps
# the documented default, which points at UAT so a misconfiguration fails
# against the test switch instead of ringing a real client.
CUBE_QUICKCALL_URL=

# TENANT credentials, for AuthToken. These are NOT an agent's credentials.
#
# The distinction matters and is easy to get wrong, because Cube issues agent
# logins that look just like these. An agent credential here fails at AuthToken
# with a 401 that reads like a typo'd password rather than like the wrong kind
# of account. Agent credentials (AgentId + Password + Extension) belong to
# AuthLogin, which is agent session control — a separate, opt-in feature — and
# they are not configured here at all.
#
# Click-to-call needs these too: AuthClick2Call is a secure endpoint, so it
# sits behind the same AuthToken. Without tenant credentials nothing dials.
#
# While either is unset the adapter simulates, whatever CUBE_QUICKCALL_URL says.
CUBE_QUICKCALL_USER=
CUBE_QUICKCALL_PASSWORD=
CUBE_QUICKCALL_TENANT=

# CampaignId as CUBE knows it, used when a lead's team does not map its own.
# Must be a campaign that exists in Cube, or calls naming it are rejected.
CUBE_QUICKCALL_CAMPAIGN=

# Shared secret QuickCall must present on its "Save Call API" callback.
# Generate one and give it to Cube when they configure the callback URL to:
#   POST https://<crm-host>/api/webhooks/quickcall/call
#   GET  https://<crm-host>/api/webhooks/quickcall/screenpop?number={number}
# Until this is set, call callbacks are REFUSED rather than trusted.
CUBE_QUICKCALL_WEBHOOK_SECRET=

# ------------------------------------------- Smartping WhatsApp (AiSensy) --

# backend.api-wa.co for white-label partner tenants,
# backend.aisensy.com for direct tenants. Confirm which applies to Bonanza.
SMARTPING_API_URL=https://backend.api-wa.co
SMARTPING_API_KEY=
SMARTPING_CAMPAIGN=BONANZA_CRM

# Callback URL to register in the Smartping dashboard:
#   POST https://<crm-host>/api/webhooks/smartping/whatsapp
SMARTPING_WEBHOOK_SECRET=

# ------------------------------------------------------- Bonanza eKYC ----

BONANZA_KYC_URL=https://kyc.bonanzaonline.com

# internal | handoff | both  — see src/vendors/bonanzakyc.js for what each means.
BONANZA_KYC_MODE=internal

# Server-to-server status API, if the eKYC team exposes one.
BONANZA_KYC_API_URL=
BONANZA_KYC_API_KEY=

# Callback URL for the eKYC platform to post status changes to:
#   POST https://<crm-host>/api/webhooks/bonanza-kyc/status
BONANZA_KYC_WEBHOOK_SECRET=

# ---------------------------------------------------------------- email ----

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=crm@bonanzaonline.com

# ----------------------------------------------------------------- misc ----

# Forces every adapter to simulate even when credentials are present.
# Useful for a demo on a production build.
CRM_SIMULATE_INTEGRATIONS=false

CRM_VENDOR_TIMEOUT_MS=12000

# ---------------------------------------------------------------- market data
# NSE / BSE feed. Bonanza already licenses one for the trading platform; until
# these are set the adapter serves a simulated feed and every screen says so.
CRM_MARKETDATA_URL=
CRM_MARKETDATA_KEY=
CRM_MARKETDATA_PROVIDER=simulated
# Regulatory delay applied to every figure shown. Do not lower without a
# real-time redistribution licence.
CRM_MARKET_DELAY_MIN=15

# ---------------------------------------------------------------------- meta
# Facebook / Instagram. The app secret signs the Lead Ads webhook — without it
# an unsigned delivery could inject leads, so it is refused.
META_APP_ID=
META_APP_SECRET=
META_PAGE_TOKEN=
META_VERIFY_TOKEN=
META_AD_ACCOUNT_ID=

# Custom Audiences send hashed client identifiers to Meta — client data leaving
# India, which conflicts with this firm's own residency rule. OFF unless
# compliance has signed it off.
CRM_META_AUDIENCES_ENABLED=false

# ----------------------------------------------------------------- approvals
# How many records a bulk action may touch before it needs a second approver.
CRM_BULK_APPROVAL_THRESHOLD=25

# Outbound email (P2-09). Relays through a mail server Bonanza runs, so nothing
# leaves India. Without these the composer records the message and delivers
# nothing, which is what it did for every email until 1 September 2026.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=crm@bonanzaonline.com

# Staff location on in-person meetings (P2-01). OFF by default: capturing an
# employee's position is personal data under DPDP, and whether the firm may do
# it at all is Compliance's decision rather than engineering's. Everything the
# regulation asks for is built — stated purpose on the field definition, 12
# month retention enforced on boot, notice shown at capture, and the RM can see
# what was recorded about them. Set to true only once Compliance has signed off.
GEO_CAPTURE_ENABLED=false
